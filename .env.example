# ------------------------------------------------------------------
# NexDraft — environment variables
# Copy this file to `.env.local` and fill in your own values:
#   cp .env.example .env.local
# ------------------------------------------------------------------

# Supabase project settings → Project Settings → Data API
# Used by both the browser client and the server/middleware client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Base URL of the NexDraft generation API.
# When set, `/api/v1/prd` requests are proxied to `${NEXT_PUBLIC_API_URL}/api/v1/prd`
NEXT_PUBLIC_API_URL=https://api.your-domain.com

# Canonical app URL. Used for OAuth redirects and Supabase auth callbacks.
NEXT_PUBLIC_APP_URL=https://nex-draft.vercel.app

# Local development URL, used when NODE_ENV=development.
NEXT_PUBLIC_APP_URL_LOCAL=http://localhost:3000

# Server-only API key. Never expose this to the browser.
NEXDRAFT_API_KEY=your-server-side-api-key
